# Copy to .env and adjust. Real environment variables override this file.

# Roots scanned for feed sub-folders (comma-separated).
# Transit and ferry are built into SEPARATE databases — never merged.
GTFS_ROOTS=bus-gtfs
# Output SQLite file for the transit build.
GTFS_DB=gtfs.sqlite
# Only include these feed folder names (empty = all).
GTFS_FEEDS=
# Where validation reports are written.
GTFS_LOG_DIR=logs
# Prefix IDs with the feed name (off by default: IDs stay as in the GTFS files).
GTFS_PREFIX=false
# Build even when validation reports errors.
GTFS_FORCE=false

# Database served by api.py for mode=transit (defaults to GTFS_DB when unset).
API_DB=gtfs.sqlite
# Database served by api.py for mode=ferry (defaults to WATER_GTFS_DB).
API_FERRY_DB=water-gtfs.sqlite
API_RAIL_DB=rail-gtfs.sqlite
# Mode used when the caller omits ?mode=
API_DEFAULT_MODE=transit
API_PORT=8000
VITE_PORT=5173

# Water GTFS (build separately):
#   python3 gtfs_builder.py --gtfs water-gtfs --db water-gtfs.sqlite
WATER_GTFS_ROOTS=water-gtfs
WATER_GTFS_DB=water-gtfs.sqlite

# ── Rail GTFS — separate database, never merged with transit/ferry ───────────
# Built by the same `gtfs_builder.py` run; use --only rail to rebuild alone.
RAIL_GTFS_ROOTS=rail-gtfs
RAIL_GTFS_DB=rail-gtfs.sqlite
# Only include these rail feed folder names (empty = all feeds).
RAIL_GTFS_FEEDS=

# ── GTFS-Realtime Configuration ──────────────────────────────────────────────
REALTIME_ENABLED=true
REALTIME_ENGINE=auto                         # redis | memory | auto
REALTIME_REDIS_URL=                          # Optional: e.g. redis://127.0.0.1:6379/0
REALTIME_LOCK_TTL_SECONDS=45

# Feeds URLs
REALTIME_TRIP_UPDATES_URL=https://gtfs.ovapi.nl/nl/tripUpdates.pb
REALTIME_TRAIN_UPDATES_URL=https://gtfs.ovapi.nl/nl/trainUpdates.pb
REALTIME_VEHICLE_POSITIONS_URL=https://gtfs.ovapi.nl/nl/vehiclePositions.pb
REALTIME_ALERTS_URL=https://gtfs.ovapi.nl/nl/alerts.pb

# Polling intervals in seconds
REALTIME_POLL_INTERVAL_TRIP_UPDATES=30
REALTIME_POLL_INTERVAL_TRAIN_UPDATES=30
REALTIME_POLL_INTERVAL_VEHICLE_POSITIONS=30
REALTIME_POLL_INTERVAL_ALERTS=60

# HTTP timeouts and retries
REALTIME_HTTP_TIMEOUT_SECONDS=15
REALTIME_HTTP_MAX_RETRIES=2

# Stale thresholds in seconds
REALTIME_STALE_THRESHOLD_UPDATES=90
REALTIME_STALE_THRESHOLD_ALERTS=180

# ── Spatial & Nearby Search Configuration ────────────────────────────────────
# Default initial search radius in meters for nearby routes and stops (Level 1)
NEARBY_RADIUS_METERS=500

# Hierarchical fallback search thresholds in meters
# Level 2: City fallback (~15 km)
NEARBY_CITY_RADIUS_METERS=15000
# Level 3: State fallback (~60 km)
NEARBY_STATE_RADIUS_METERS=60000
